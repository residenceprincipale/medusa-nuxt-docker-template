# Backend
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa
REDIS_URL=redis://redis:6379
JWT_SECRET=changeme
COOKIE_SECRET=changeme
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Stripe (optional - leave empty to use system_default)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP) - leave blank to disable sending (password reset / newsletter)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
STOREFRONT_URL=http://localhost:3000

# S3 file storage (optional - leave empty to use local /static persisted by volume)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PREFIX=

# Nuxt storefront
NUXT_PUBLIC_MEDUSA_BACKEND=http://localhost:9000
NUXT_SERVER_MEDUSA_BACKEND=http://backend:9000
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
# Admin panel URL (storefront /admin redirects here)
NUXT_PUBLIC_MEDUSA_ADMIN_URL=http://localhost:9000/app
